{
  "name": "cabalspy-mcp",
  "version": "0.1.0",
  "description": "MCP server for the CabalSpy API \u2014 query KOL, smart money and whale wallet activity on Solana, Base, BNB Chain, Ethereum and Robinhood Chain from Claude, Cursor and other AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "cursor",
    "cabalspy",
    "kol",
    "kol-api",
    "smart-money",
    "whale-tracker",
    "wallet-tracker",
    "onchain-data",
    "memecoin",
    "bundle-detection",
    "trading-signals",
    "solana",
    "base",
    "bnb",
    "ethereum",
    "robinhood-chain",
    "ai-agent"
  ],
  "license": "MIT",
  "homepage": "https://docs.cabalspy.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_ORG/cabalspy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_ORG/cabalspy-mcp/issues"
  },
  "type": "module",
  "bin": {
    "cabalspy-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node test-protocol.mjs",
    "test:live": "node test-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cabalspy": "^0.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
